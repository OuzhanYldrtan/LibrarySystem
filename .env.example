# PostgreSQL (yerel Postgres.app için DATABASE_URL boş bırakılabilir)
DATABASE_URL=
PGDATABASE=library_assistant
PGHOST=/tmp
PGPORT=5432

# Gemini API (anahtarı Google AI Studio'dan oluşturun)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Uygulama
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
MCP_SERVER_PATH=apps/mcp/dist/index.js
